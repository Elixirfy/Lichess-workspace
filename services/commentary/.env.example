BLV_TOKEN=replace-with-a-random-secret
BLV_STOCKFISH=stockfish
BLV_EVAL_FILE=
# Paste a Google AI Studio API key here; auto selects Gemini when this is nonempty.
# Keep this file's values in the ignored .env, never in Lila/browser configuration.
GEMINI_API_KEY=
# auto | gemini | piper | vieneu. Explicit piper always uses offline voices, even with a key.
BLV_TTS_PROVIDER=vieneu
BLV_GEMINI_MODEL=gemini-3.1-flash-tts-preview
BLV_GEMINI_VOICE=Kore
# Cloud request deadline (seconds), within the 12-second commentary job lifetime.
BLV_GEMINI_TIMEOUT=7
# Optional natural-language delivery instructions; omit to use Vietnamese commentary defaults.
# BLV_GEMINI_STYLE=
BLV_PIPER_MODEL=/path/to/vi_VN-vivos-x_low.onnx
# Folder of the other voices' models (vi_VN-vivos-x_low.onnx + .json); empty = next to BLV_PIPER_MODEL.
BLV_PIPER_DIR=
BLV_ENGINE_MS=100
BLV_TTS_TIMEOUT=4
# 1 = include engine facts in responses (local debugging only; Lila strips them anyway).
BLV_DEBUG_FACTS=

# VieNeu v3 Nano: model directory downloaded at the pinned revision in nano-assets.json.
BLV_NANO_DIR=
# BLV_NANO_PYTHON=/absolute/path/to/.venv-nano/bin/python
BLV_NANO_TIMEOUT=7
BLV_NANO_THREADS=1
BLV_NANO_STEPS=16

# Speaking rate; higher is faster without changing the 24 kHz playback rate.
BLV_NANO_SPEED=1.2
