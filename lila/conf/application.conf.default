include "base"
include "version"

# give empty list for socket domains to quickly disable websockets (removes the red disconnecting nag)
# net.socket.domains = []

# uncomment to disable ratelimits which can get in the way of site testing
# net.ratelimit = false

# change for additional encryption of password hashes
user.password.bpass.secret = "9qEYN0ThHer1KWLNekA76Q=="

# override additional values from base.conf here
aiCoach {
  enabled = false
  workerUrl = "http://127.0.0.1:8137"
  internalToken = ""
  internalToken = ${?COACH_INTERNAL_TOKEN}
  parallelism = 1
  guestRetentionDays = 7
  accountRetentionDays = 30
  maxQuestions = 128
  abandonAfterHours = 24
  summaryWaitSeconds = 30
}
