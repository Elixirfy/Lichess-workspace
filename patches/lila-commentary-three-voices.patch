+test('cloud audio may arrive after six seconds while the same position is current', async () => {
+  const t = setup();
+  t.ctrl.toggle();
+  const move = t.state('s:1', 1, NF3);
+  t.sources[0].send(move);
+  t.board.ply = 1;
+  t.board.fen = NF3;
+  t.tick(6000);
+  const result = t.comment(move, 'Trắng đưa mã lên f3.');
+  result.audio!.provider = 'gemini:gemini-3.1-flash-tts-preview';
+  t.sources[0].send(result);
+  await setImmediate();
+  assert.equal(t.ctrl.phase, 'speaking');
+  assert.equal(t.ctrl.subtitle, result.text);
+  t.ctrl.destroy();
+});
+
+test('cloud audio still expires and is dropped after a newer move', async () => {
+  for (const newerMove of [false, true]) {
+    const t = setup();
+    t.ctrl.toggle();
+    const move = t.state('s:1', 1, NF3);
+    t.sources[0].send(move);
+    t.board.ply = 1;
+    t.board.fen = NF3;
+    if (newerMove) {
+      t.sources[0].send(t.state('s:2', 2, NF6));
+      t.board.ply = 2;
+      t.board.fen = NF6;
+    }
+    t.tick(newerMove ? 6000 : 10500);
+    const result = t.comment(move, 'Lời bình cũ.');
+    result.audio!.provider = 'gemini:gemini-3.1-flash-tts-preview';
+    t.sources[0].send(result);
+    await setImmediate();
+    assert.notEqual(t.ctrl.phase, 'speaking');
+    assert.notEqual(t.ctrl.subtitle, result.text);
+    t.ctrl.destroy();
+  }
+});
+
+test('a cloud timeout still shows subtitles after six seconds', async () => {
+  const t = setup();
+  t.ctrl.toggle();
+  const move = t.state('s:1', 1, NF3);
+  t.sources[0].send(move);
+  t.board.ply = 1;
+  t.board.fen = NF3;
+  t.tick(6000);
+  t.sources[0].send({ ...t.comment(move, 'Trắng đưa mã lên f3.', false), ttsProvider: 'gemini' });
+  await setImmediate();
+  assert.equal(t.ctrl.subtitle, 'Trắng đưa mã lên f3.');
+  assert.match(t.ctrl.status, /chỉ có phụ đề/);
+  t.ctrl.destroy();
+});
+
