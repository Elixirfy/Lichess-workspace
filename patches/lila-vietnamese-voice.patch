+  cg.set({ fen, movable: { dests: new Map([['e4', ['e5']]]) } });
+  move.update({ fen, canMove: true });
+  say('tốt e bốn e năm');
+  assert.deepEqual(sent, [
+    ['e2', 'e4', undefined, true],
+    ['e4', 'e5', undefined, true],
+  ]);
+});
+
+test('a source-square selection can be followed by a direct destination move', async t => {
+  const { move, say, sent } = await setup(t, start, [['f2', ['f3', 'f4']]]);
+  say('ép hai');
+  assert.equal(move.question(), false);
+  assert.deepEqual(sent, []);
+  say('ép bốn');
+  assert.deepEqual(sent, [['f2', 'f4', undefined, true]]);
+});
+
+test('a direct move never accepts a pending opponent request', async t => {
+  const { move, say, sent } = await setup(t);
+  const drawAnswers: boolean[] = [];
+  move.listenForResponse('draw', answer => drawAnswers.push(answer));
+  say('e hai e bốn');
+  assert.deepEqual(sent, [['e2', 'e4', undefined, true]]);
+  assert.deepEqual(drawAnswers, []);
+});
+
+test('out-of-turn and completed positions reject Vietnamese moves', async t => {
+  const { move, say, sent } = await setup(t);
+  move.update({ fen: start, canMove: false });
+  say('e hai e bốn');
+  say('xác nhận');
+  assert.deepEqual(sent, []);
+});
+
+test('an illegal coordinate or unknown speech cannot be shortened into a legal move', async t => {
+  const { say, sent } = await setup(t);
+  for (const phrase of ['e hai e năm', 'đừng đi e hai e bốn', 'xin chào']) {
+    say(phrase);
+    say('xác nhận');
+  }
+  assert.deepEqual(sent, []);
+});
+
+test('two knights require disambiguation and then execute without confirmation', async t => {
+  const { say, sent, cg } = await setup(t, '7k/8/8/8/8/5N2/8/1N5K w - - 0 1', [
+    ['b1', ['d2']],
+    ['f3', ['d2']],
+  ]);
+  say('mã d hai');
+  say('xác nhận');
+  assert.deepEqual(sent, []);
+  assert.equal(cg.state.drawable.shapes.length, 2);
+  say('xanh');
+  assert.deepEqual(sent, [['b1', 'd2', undefined, true]]);
+});
+
+test('Vietnamese castling and promotion preserve the intended legal move', async t => {
+  const castle = await setup(t, '4k3/8/8/8/8/8/8/R3K2R w KQ - 0 1', [['e1', ['a1', 'h1']]]);
+  castle.say('nhập thành cánh vua');
+  castle.say('xác nhận');
+  assert.deepEqual(castle.sent, [['e1', 'h1', undefined, true]]);
+  const promotion = await setup(t, '7k/4P3/8/8/8/8/8/7K w - - 0 1', [['e7', ['e8']]]);
+  promotion.say('e tám phong mã');
+  promotion.say('xác nhận');
+  assert.deepEqual(promotion.sent, [['e7', 'e8', 'knight', true]]);
+});
+
+test('Vietnamese letter-name ép addresses the f-file without losing its coordinate', async t => {
+  const { say, sent } = await setup(t, start, [['g1', ['f3', 'h3']]]);
+  say('mã ép ba');
+  say('xác nhận');
+  assert.deepEqual(sent, [['g1', 'f3', undefined, true]]);
+});
+
+test('misheard dờ as giờ is a file only in explicit chess coordinates', async t => {
+  for (const [phrase, from, to] of [
+    ['tốt giờ hai tới giờ bốn', 'd2', 'd4'],
+    ['tốt gờ hai tới gờ bốn', 'g2', 'g4'],
+  ] as const) {
+    const { say, sent } = await setup(t, start, [
+      ['d2', ['d4']],
+      ['g2', ['g4']],
+    ]);
+    say(phrase);
+    assert.deepEqual(sent, [[from, to, undefined, true]], phrase);
+  }
+  for (const text of [
+    'giờ hai tới giờ bốn',
+    'tốt giờ bốn',
+    'bây giờ tốt đê hai tới đê bốn',
+    'không tốt giờ hai tới giờ bốn',
+  ]) {
+    const { say, sent } = await setup(t, start, [
+      ['d2', ['d4']],
+      ['g2', ['g4']],
+    ]);
+    say(text);
+    assert.deepEqual(sent, [], text);
+  }
+});
+
+test('incomplete numeric columns and misplaced từ still cannot propose a move', async t => {
+  const { say, sent, move } = await setup(t, start, [['b2', ['b3', 'b4']]]);
+  for (const text of ['tốt từ cột hàng hai đến cột hàng bốn', 'tốt bê hai từ bê bốn']) {
+    say(text);
+    assert.equal(move.question(), false);
+    say('xác nhận');
+  }
+  assert.deepEqual(sent, []);
+});
+
+test('direct Vietnamese moves submit immediately with no confirmation question', async t => {
+  const { say, sent, move } = await setup(t);
+  assert.equal(say('tốt trắng e hai e bốn'), true);
+  assert.deepEqual(sent, [['e2', 'e4', undefined, true]]);
+  assert.equal(move.question(), false);
+  say('xác nhận');
+  assert.equal(sent.length, 1);
+});
+
+test('direct Vietnamese secondary recognition submits a legal move immediately', async t => {
+  const { say, fallback, sent, move } = await setup(t, start, [['b2', ['b3', 'b4']]]);
+  assert.equal(say('tốt từ cột hai a hai đến cột hai a bốn'), false);
+  assert.equal(fallback('tốt từ cột hai hàng hai đến cột hai hàng bốn'), true);
+  assert.deepEqual(sent, [['b2', 'b4', undefined, true]]);
+  assert.equal(move.question(), false);
+});
+
+test('direct Vietnamese duplicate results cannot send twice before a position update', async t => {
+  const { say, fallback, sent } = await setup(t);
+  say('tốt e hai tới e bốn');
+  say('tốt e hai tới e bốn');
+  fallback('tốt e hai tới e ba');
+  assert.deepEqual(sent, [['e2', 'e4', undefined, true]]);
+});
+
+test('direct Vietnamese illegal final recognition reports feedback without moving', async t => {
+  const { say, fallback, sent, notices, move } = await setup(t);
+  assert.equal(say('tốt e hai tới e năm'), false, 'Allow secondary ASR to recover primary errors');
+  assert.deepEqual(notices, []);
+  fallback('tốt e hai tới e năm');
+  assert.match(notices.at(-1) ?? '', /không hợp lệ/u);
+  assert.deepEqual(sent, []);
+  assert.equal(move.question(), false);
+});
+
+test('direct Vietnamese unrecognized final speech reports feedback without dropping words', async t => {
+  const { fallback, sent, notices } = await setup(t);
+  fallback('đừng đi tốt e hai tới e bốn');
+  assert.ok(notices.at(-1)?.length);
+  assert.deepEqual(sent, []);
+});
+
+test('direct Vietnamese ambiguity asks for a source before executing the clarified move', async t => {
+  const { say, sent, notices, move } = await setup(t, '7k/8/8/8/8/5N2/8/1N5K w - - 0 1', [
+    ['b1', ['d2']],
+    ['f3', ['d2']],
+  ]);
+  say('mã đê hai');
+  assert.deepEqual(sent, []);
+  assert.ok(notices.at(-1)?.length);
+  assert.equal(move.question(), false);
+  say('mã bê một tới đê hai');
+  assert.deepEqual(sent, [['b1', 'd2', undefined, true]]);
+});
+
+test('direct Vietnamese incomplete one-word speech still shows final feedback', async t => {
+  const { fallback, notices, sent } = await setup(t);
+  fallback('mã');
+  assert.ok(notices.at(-1)?.length);
+  assert.deepEqual(sent, []);
+});
diff --git a/ui/voice/tests/vosk.test.ts b/ui/voice/tests/vosk.test.ts
new file mode 100644
index 0000000..bf48b77
--- /dev/null
+++ b/ui/voice/tests/vosk.test.ts
@@ -0,0 +1,208 @@
+import assert from 'node:assert/strict';
+import { mock, test } from 'node:test';
+
+import type { RecognizerOpts } from '../src/interfaces';
+
+const recognizers: FakeRecognizer[] = [];
+class FakeRecognizer {
+  handlers = new Map<string, (msg: any) => void>();
+  removed = false;
+  constructor() {
+    recognizers.push(this);
+  }
+  on(event: string, handler: (msg: any) => void) {
+    this.handlers.set(event, handler);
+  }
+  remove() {
+    this.removed = true;
+  }
+  retrieveFinalResult() {}
+  acceptWaveform() {}
+  acceptWaveformFloat() {}
+  emit(text: string) {
+    this.handlers.get('result')!({ result: { text } });
+  }
+}
+class FakeClient {
+  KaldiRecognizer = FakeRecognizer;
+  handlers = new Map<string, (msg: any) => void>();
+  terminated = false;
+  constructor() {
+    const load = loadClient;
+    queueMicrotask(() => load(this));
+  }
+  on(event: string, handler: (msg: any) => void) {
+    this.handlers.set(event, handler);
+  }
+  emit(event: string, message: any) {
+    this.handlers.get(event)?.(message);
+  }
+  terminate() {
+    this.terminated = true;
+  }
+}
+const loaded = (client: FakeClient) => client.emit('load', { result: true });
+let loadClient: (client: FakeClient) => void = loaded;
+mock.module('@lichess-org/vosk-browser', { namedExports: { VoskClient: FakeClient } });
+const { initModule } = await import('../src/voice.vosk');
+
+test('late results from replaced position recognizers are discarded', async () => {
+  Object.assign(site, { asset: { url: (path: string) => path } });
+  const vosk = initModule();
+  await vosk.initModel('/model.tar.gz', 'vi');
+  const heard: string[] = [];
+  const opts = {
+    words: ['e', 'hai', 'bốn'],
+    recId: 'default',
+    partial: false,
+    audioCtx: { sampleRate: 16000, createScriptProcessor: () => ({}) },
+    broadcast: (text: string) => heard.push(text),
+  } as unknown as RecognizerOpts;
+  vosk.initRecognizer(opts);
+  const old = recognizers.at(-1)!;
+  vosk.initRecognizer(opts);
+  assert.equal(old.removed, true, 'Replacing an inactive recognizer must release its model resources');
+  old.emit('e hai e bốn');
+  recognizers.at(-1)!.emit('mã f ba');
+  assert.deepEqual(heard, ['mã f ba']);
+});
+
+test('full results carry only audio acknowledged for that utterance, including an empty transcript', async () => {
+  Object.assign(site, { asset: { url: (path: string) => path } });
+  const vosk = initModule();
+  await vosk.initModel('/model.tar.gz', 'vi');
+  const packets: number[][] = [];
+  const node = {} as ScriptProcessorNode;
+  vosk.initRecognizer({
+    words: ['ép', 'bốn'],
+    recId: 'default',
+    partial: false,
+    audioCtx: { sampleRate: 16000, createScriptProcessor: () => node },
+    broadcast() {},
+    audioResult: (_text: string, samples: Float32Array) => packets.push([...samples]),
+  } as unknown as RecognizerOpts);
+  vosk.select('default');
+  const rec = recognizers.at(-1)!;
+  for (const samples of [
+    [1, 2],
+    [3, 4],
+    [5, 6],
+  ])
+    node.onaudioprocess!({ inputBuffer: { getChannelData: () => new Float32Array(samples) } } as any);
+  rec.handlers.get('partialresult')?.({ result: { partial: '' } });
+  rec.emit('');
+  assert.deepEqual(packets, [[1, 2, 3, 4]]);
+  rec.handlers.get('partialresult')?.({ result: { partial: '' } });
+  vosk.select(false);
+  rec.emit('ép bốn');
+  assert.deepEqual(packets, [
+    [1, 2, 3, 4],
+    [5, 6],
+  ]);
+});
+
+test('a failed language load cannot report the terminated previous model as ready', async () => {
+  const vosk = initModule();
+  loadClient = loaded;
+  await vosk.initModel('/vi.tar.gz', 'vi');
+  let failed!: FakeClient;
+  loadClient = client => {
+    failed = client;
+    client.emit('error', { error: 'Invalid archive' });
+  };
+  await assert.rejects(vosk.initModel('/bad.tar.gz', 'fr'), /Invalid archive/);
+  assert.equal(vosk.isLoaded(), false);
+  assert.equal(failed.terminated, true);
+  loadClient = loaded;
+  await vosk.initModel('/vi.tar.gz', 'vi');
+  assert.equal(vosk.isLoaded('vi'), true);
+});
+
+test('a slow old model load cannot replace a newly selected language', async () => {
+  const vosk = initModule();
+  let finish!: () => void;
+  loadClient = client => {
+    finish = () => loaded(client);
+  };
+  const old = vosk.initModel('/slow.tar.gz', 'fr');
+  loadClient = loaded;
+  await vosk.initModel('/vi.tar.gz', 'vi');
+  finish();
+  await old;
+  assert.equal(vosk.isLoaded('vi'), true);
+  assert.equal(vosk.isLoaded('fr'), false);
+});
+
+test('an unresponsive model load times out and releases its worker', async t => {
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  let pending!: FakeClient;
+  loadClient = client => {
+    pending = client;
+  };
+  const vosk = initModule();
+  const loading = vosk.initModel('/unresponsive.tar.gz', 'vi');
+  const rejected = assert.rejects(loading, /timed out/);
+  await Promise.resolve();
+  t.mock.timers.tick(30000);
+  await rejected;
+  assert.equal(pending.terminated, true);
+  assert.equal(vosk.isLoaded(), false);
+  loadClient = loaded;
+});
+
+test('one-shot decoding waits for worker acknowledgements, accepts a full grammar phrase and cleans up', async () => {
+  const vosk = initModule();
+  await vosk.initModel('/vi.tar.gz', 'vi');
+  assert.equal(typeof vosk.transcribe, 'function');
+  const samples = new Float32Array(16000).fill(0.2);
+  const pending = vosk.transcribe(
+    samples,
+    16000,
+    ['tốt bi hai bi bốn', '[unk]', 'không'],
+    new AbortController().signal,
+  );
+  const rec = recognizers.at(-1)!;
+  let resolved = false;
+  void pending.then(() => {
+    resolved = true;
+  });
+  rec.handlers.get('partialresult')?.({ result: { partial: '' } });
+  await Promise.resolve();
+  assert.equal(resolved, false);
+  rec.emit('tốt bi hai bi bốn');
+  assert.equal(await pending, 'tốt bi hai bi bốn');
+  assert.equal(rec.removed, true);
+  assert.equal(samples[0], Math.fround(0.2));
+});
+
+test('one-shot decoding rejects word-loop guesses and is released on abort, timeout and model replacement', async t => {
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  const vosk = initModule();
+  await vosk.initModel('/vi.tar.gz', 'vi');
+  assert.equal(typeof vosk.transcribe, 'function');
+  const grammar = ['tốt bi hai bi bốn', '[unk]', 'không'];
+  const run = (signal = new AbortController().signal) =>
+    vosk.transcribe(new Float32Array(16000), 16000, grammar, signal);
+  const invalid = run();
+  const invalidRec = recognizers.at(-1)!;
+  invalidRec.emit('tốt tốt bi hai bi bốn');
+  invalidRec.emit('');
+  assert.equal(await invalid, undefined);
+  const controller = new AbortController();
+  const aborted = run(controller.signal);
+  const abortedRec = recognizers.at(-1)!;
+  controller.abort();
+  assert.equal(await aborted, undefined);
+  assert.equal(abortedRec.removed, true);
+  abortedRec.emit('tốt bi hai bi bốn');
+  const timed = run();
+  const timedRec = recognizers.at(-1)!;
+  t.mock.timers.tick(2000);
+  assert.equal(await timed, undefined);
+  assert.equal(timedRec.removed, true);
+  const old = run();
+  const oldRec = recognizers.at(-1)!;
+  await vosk.initModel('/fr.tar.gz', 'fr');
+  assert.equal(await old, undefined);
+  assert.equal(oldRec.removed, true);
+});
