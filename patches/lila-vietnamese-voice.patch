+test('push-to-talk release accepts its final result, hard stop ignores it', async () => {
+  const { mic, captures } = environment();
+  const heard: string[] = [];
+  mic.initRecognizer(['ép'], {
+    listener: (text, type) => {
+      if (type === 'full') heard.push(text);
