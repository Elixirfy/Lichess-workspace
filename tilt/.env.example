# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# Secret used to pseudonymise usernames in exports. Keep it outside the repo,
# e.g. in ~/.tilt-salt, and load it with: export TILT_SALT="$(cat ~/.tilt-salt)"
TILT_SALT=

# Optional Lichess personal API token for higher collect-api rate limits (no scopes needed).
LICHESS_TOKEN=
